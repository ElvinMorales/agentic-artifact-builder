root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

# Markdown files in this repo use trailing whitespace deliberately: two
# trailing spaces for a hard line break, and a bare trailing space on blank
# checklist items (see .github/PULL_REQUEST_TEMPLATE.md).
[*.md]
trim_trailing_whitespace = false
